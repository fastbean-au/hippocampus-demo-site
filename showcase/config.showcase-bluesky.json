{
  "logging": {
    "level": "info",
    "json": true
  },
  "port": 50051,
  "gateway": {
    "port": 8080
  },
  "auth": {
    "method": "idp",
    "issuer": "http://localhost:8093/realms/hippocampus",
    "audience": "",
    "roleClaim": "realm_access.roles",
    "roleMapping": {},
    "jwksRefreshIntervalSeconds": 300,
    "readerRecallReinforces": false,
    "ui": {
      "issuer": "http://localhost:8093/realms/hippocampus",
      "clientId": "hippocampus-console",
      "scopes": "openid profile",
      "audience": ""
    }
  },
  "tls": {
    "enabled": false,
    "certFile": "",
    "keyFile": ""
  },
  "observability": {
    "tracing": {
      "enabled": true,
      "samplingRatio": 1.0
    },
    "metrics": {
      "enabled": true,
      "exportIntervalSeconds": 30
    },
    "otlp": {
      "endpoint": "otel-lgtm:4317",
      "insecure": true
    }
  },
  "storage": {
    "driver": "postgres",
    "directory": "",
    "postgres": {
      "dsn": "postgres://hippocampus:hippocampus@postgres:5432/hippocampus?sslmode=disable"
    }
  },
  "opensearch": {
    "enabled": true,
    "addresses": ["http://opensearch:9200"],
    "username": "",
    "password": "",
    "index": "bluesky-memories",
    "queueSize": 4096,
    "reconcileIntervalSeconds": 600,
    "reconcileBatchSize": 500
  },
  "ollama": {
    "enabled": true,
    "autoSummarise": true,
    "address": "http://ollama:11434",
    "model": "qwen2.5:0.5b",
    "timeoutSeconds": 45,
    "maxMemories": 40,
    "promptCharLimit": 6000,
    "temperature": 0.2
  },
  "memory": {
    "limit": {
      "sizeBytes": 8192
    },
    "minimumSignificance": 0
  },
  "event": {
    "minimumSignificance": 0
  },
  "sleep": {
    "periodSeconds": 180
  },
  "consolidation": {
    "defaultEventSignificanceValue": 0,
    "defaultEventSignificancePercentile": 0,
    "minimumAgeInDays": 0,
    "minimumRetentionInDays": 0,
    "aggressiveness": 1.0,
    "deletionThreshold": 5,
    "method": 1,
    "unitsOfAgeInDays": 0.125,
    "linkSignificanceWeight": 1.0,
    "linkRecallPropagation": 0.25,
    "recallSignificanceWeight": 5.0,
    "capacityMemories": 1600,
    "capacityPressureExponent": 4.0,
    "capacityBytes": 850000,
    "capacityBytesFloor": 680000,
    "walTriggerBytes": 0,
    "summarisationMinMemories": 3,
    "summarisationMinAgeInDays": 0,
    "summarisationMaxCandidates": 3,
    "tombstones": {
      "enabled": true,
      "maxRows": 100000,
      "maxAgeInDays": 30
    }
  },
  "topology": {
    "components": [
      {
        "name": "hippocampus-bluesky-bridge",
        "kind": "bridge",
        "healthUrl": "http://hippocampus-bluesky-bridge:8090"
      },
      {
        "name": "hippocampus-bluesky-bridge-worldnews",
        "kind": "bridge",
        "healthUrl": "http://hippocampus-bluesky-bridge-worldnews:8090"
      }
    ]
  }
}
