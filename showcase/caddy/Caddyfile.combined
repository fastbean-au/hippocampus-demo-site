# Caddy reverse proxy for the COMBINED showcase (both examples, one domain, one host). A single Caddy
# owns :80/:443 and routes five subdomains of one parent domain to the two consoles, the shared
# Keycloak, the shared Grafana, and the configuration wizard. See Caddyfile.book for the split-issuer rationale; the difference
# here is that ONE Caddy fronts BOTH stacks (two Caddys cannot share the host ports), and auth./
# grafana. are shared rather than per-stack.
#
# Everything derives from one variable, BASE_DOMAIN (default hippocampus.example). Requires public
# DNS for bluesky.${BASE_DOMAIN}, book.${BASE_DOMAIN}, logs.${BASE_DOMAIN}, agent.${BASE_DOMAIN},
# agent-flat.${BASE_DOMAIN}, auth.${BASE_DOMAIN},
# grafana.${BASE_DOMAIN},
# config-builder.${BASE_DOMAIN} (or a
# *.${BASE_DOMAIN} wildcard) pointing at the host, with 80/443 reachable for the ACME challenge. NB do
# NOT use a *.localhost name here: libc/Go resolve the .localhost TLD to loopback (RFC 6761) and
# bypass the compose DNS alias, which would break the split-issuer fix.
{
	email {$ACME_EMAIL:admin@example.com}
}

# Apex landing page. Proxied to the hippocampus-site service on the shared network — the static
# site built from the repo root and brought up as part of this stack. Override the target with
# SITE_UPSTREAM to point elsewhere; if the upstream is ever absent the apex simply 502s while every
# subdomain below keeps working.
{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy {$SITE_UPSTREAM:hippocampus-site:80}
}

bluesky.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-bluesky:8080
}

book.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-book:8080
}

logs.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-logs:8080
}

# The agent pair. Two hosts rather than one because they are two stores, and the comparison is made
# by opening both and searching each for the same thing.
agent.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-agent:8080
}

agent-flat.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy hippocampus-agent-flat:8080
}

auth.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy keycloak:8080
}

grafana.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy otel-lgtm:3000
}

# Configuration and deployment wizard — a static tool, not a demo instance. It talks to nothing (no
# API, no store, no identity provider), so there is nothing here to authenticate or isolate.
config-builder.{$BASE_DOMAIN:hippocampus.example} {
	reverse_proxy config-builder:8091
}
