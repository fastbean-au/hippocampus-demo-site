{
  "realm": "hippocampus",
  "enabled": true,
  "displayName": "Hippocampus Showcase",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "reader",
        "description": "Read-only access to the Hippocampus API"
      },
      {
        "name": "writer",
        "description": "Create/update/delete memories and events"
      },
      {
        "name": "admin",
        "description": "Administrative and destructive operations (Purge, Sleep, ...)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "hippocampus-console",
      "name": "Hippocampus Web Console",
      "description": "Public single-page client for the /ui console: Authorization Code + PKCE, no secret.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "redirectUris": [
        "https://bluesky.hippocampus.example/ui",
        "http://localhost:8080/ui",
        "http://localhost:8081/ui",
        "https://book.hippocampus.example/ui",
        "https://agent.hippocampus.example/ui",
        "https://agent-flat.hippocampus.example/ui",
        "https://observer.hippocampus.example/ui"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "hippocampus-gen",
      "name": "Hippocampus Generator (machine-to-machine)",
      "description": "Confidential client for the data generators: client-credentials grant, admin role.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "showcase-gen-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "hippocampus-bluesky-bridge",
      "name": "Hippocampus Bluesky Bridge (machine-to-machine)",
      "description": "Confidential client for the Bluesky bridge: client-credentials grant, writer role. Separate from hippocampus-gen so the bridge is identifiable in the topology view, which draws a caller under its client_id.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "showcase-gen-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "hippocampus-bluesky-bridge-worldnews",
      "name": "Hippocampus Bluesky Bridge - WorldNews feed (machine-to-machine)",
      "description": "Confidential client for the second Bluesky bridge, polling the WorldNews feed into the same store: client-credentials grant, writer role. Its own client because the topology view draws a caller under its client_id, so a shared one would merge them.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "showcase-gen-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@hippocampus.example",
      "firstName": "Demo",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": ["reader"]
    },
    {
      "username": "service-account-hippocampus-gen",
      "enabled": true,
      "serviceAccountClientId": "hippocampus-gen",
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-hippocampus-bluesky-bridge",
      "enabled": true,
      "serviceAccountClientId": "hippocampus-bluesky-bridge",
      "realmRoles": ["writer"]
    },
    {
      "username": "service-account-hippocampus-bluesky-bridge-worldnews",
      "enabled": true,
      "serviceAccountClientId": "hippocampus-bluesky-bridge-worldnews",
      "realmRoles": ["writer"]
    }
  ]
}
